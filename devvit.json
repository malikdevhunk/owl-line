{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "owl-line",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall",
        "styles": {
          "backgroundColor": "#141A2EFF",
          "backgroundColorDark": "#0E1324FF",
          "height": "tall"
        }
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT", "SUBSCRIBE_TO_SUBREDDIT"]
    }
  },
  "scheduler": {
    "tasks": {
      "daily-service": {
        "endpoint": "/internal/scheduler/daily-service",
        "cron": "0 0 * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete",
    "onCommentDelete": "/internal/triggers/on-comment-delete"
  },
  "menu": {
    "items": [
      {
        "label": "Post tonight's Owl Line",
        "description": "Create today's night service if it is not up yet",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/new-daily"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
